//FTPD     PROC M=FTPDPRM0,
//            D='SYS2.PARMLIB'
//*
//* FTPD - FTP Server STC Procedure
//*
//* Installation:
//*   Copy to SYS2.PROCLIB(FTPD)
//*   Copy config member to SYS2.PARMLIB(FTPDPRM0)
//*
//* Starting:    /S FTPD
//*              /S FTPD,M=FTPDPRM1       (alternate config member)
//*              /S FTPD,D='MY.PARMLIB'   (alternate parmlib dataset)
//* Commands:    /F FTPD,STATS
//*              /F FTPD,SESSIONS
//*              /F FTPD,CONFIG
//*              /F FTPD,HELP
//*              /F FTPD,SHUTDOWN
//* Stopping:    /P FTPD
//*
//FTPD     EXEC PGM=FTPD,REGION=8M,TIME=1440
//STEPLIB  DD  DISP=SHR,DSN=@LINKLIB@
//SYSUDUMP DD  SYSOUT=*
//STDOUT   DD  SYSOUT=*
//STDERR   DD  SYSOUT=*
//FTPDPRM  DD  DSN=&D(&M),DISP=SHR,FREE=CLOSE
//*
//* JES mode (SITE FILETYPE=JES) needs no DD here: jesopen() finds the
//* JES2 checkpoint (catalog, else OBTAIN) and the spool by itself.
//* Only add the two DDs below if JES2 runs with a DSNPRFX other than
//* SYS1, or the checkpoint is neither cataloged nor on an online
//* volume. A DD wins over the lookup. UNIT and VOL are site specific.
//*
//*HASPCKPT DD  DISP=SHR,DSN=SYS1.HASPCKPT,UNIT=unit,VOL=SER=volser
//*HASPACE1 DD  DISP=SHR,DSN=SYS1.HASPACE,UNIT=unit,VOL=SER=volser
